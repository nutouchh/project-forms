[Unit]
Description=Project Forms Flask Application
After=network.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ app_dir }}/venv/bin/gunicorn --workers 1 --bind 0.0.0.0:{{ app_port }} --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target